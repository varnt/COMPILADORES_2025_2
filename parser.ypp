%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "symbols.hpp"
#include "ast.hpp"

//Aluno Victor de Souza Arnt Matricula 00291097

int yylex(void);
extern char* yytext;
extern FILE* yyin;
extern int yylineno;
void yyerror (char const *mensagem);
int getLineNumber();

AST* root = NULL;
%}

%union {
    SYMBOL* symbol;
    AST* ast;
}

%start programa
%define parse.error verbose 

// Tokens - palavras reservadas
%token KW_CHAR KW_INT KW_FLOAT KW_BOOL
%token KW_IF KW_ELSE KW_DO KW_WHILE
%token KW_READ KW_PRINT KW_RETURN

// Operadores compostos
%token OPERATOR_LE OPERATOR_GE OPERATOR_EQ OPERATOR_DIF

// Identificadores e literais
%token<symbol> TK_IDENTIFIER
%token<symbol> LIT_INT LIT_CHAR LIT_FLOAT LIT_TRUE LIT_FLASE LIT_STRING
%token TOKEN_ERROR

// Tipos não-terminais
%type<ast> programa lista_declaracoes declaracao declaracao_variavel declaracao_funcao
%type<ast> tipo lista_literais literal parametros parametro
%type<ast> declaracoes_locais bloco lista_comandos comando
%type<ast> comando_atribuicao comando_controle comando_read comando_print comando_return
%type<ast> expressao chamada_funcao argumentos lista_print elemento_print

// Precedência dos operadores
%right '='
%left '|'
%left '&'
%left OPERATOR_EQ OPERATOR_DIF
%left '<' '>' OPERATOR_LE OPERATOR_GE
%left '+' '-'
%left '*' '/' '%'
%right '~' UMINUS
%left '[' ']'

%%

programa: lista_declaracoes { root = $$ = astCreate(AST_PROGRAM, NULL, $1, NULL, NULL, NULL); }
        ;

lista_declaracoes: declaracao lista_declaracoes { $$ = astCreate(AST_DECL_LIST, NULL, $1, $2, NULL, NULL); }
                 | declaracao { $$ = $1; }
                 ;

declaracao: declaracao_variavel { $$ = $1; }
          | declaracao_funcao { $$ = $1; }
          ;

declaracao_variavel: tipo TK_IDENTIFIER '=' literal ';' 
                    { $$ = astCreate(AST_VAR_DECL, NULL, $1, astCreate(AST_SYMBOL, $2, NULL, NULL, NULL, NULL), $4, NULL); }
                   | tipo TK_IDENTIFIER '[' LIT_INT ']' ';'
                    { $$ = astCreate(AST_VEC_DECL, NULL, $1, astCreate(AST_SYMBOL, $2, NULL, NULL, NULL, NULL), astCreate(AST_SYMBOL, $4, NULL, NULL, NULL, NULL), NULL); }
                   | tipo TK_IDENTIFIER '[' LIT_INT ']' '=' lista_literais ';'
                    { $$ = astCreate(AST_VEC_DECL_INIT, NULL, $1, astCreate(AST_SYMBOL, $2, NULL, NULL, NULL, NULL), astCreate(AST_SYMBOL, $4, NULL, NULL, NULL, NULL), $7); }
                   ;

declaracao_funcao: tipo TK_IDENTIFIER '(' parametros ')' declaracoes_locais bloco
                  { $$ = astCreate(AST_FUNC_DECL, NULL, $1, astCreate(AST_SYMBOL, $2, NULL, NULL, NULL, NULL), $4, $7); }
                 | tipo TK_IDENTIFIER '(' ')' declaracoes_locais bloco
                  { $$ = astCreate(AST_FUNC_DECL, NULL, $1, astCreate(AST_SYMBOL, $2, NULL, NULL, NULL, NULL), NULL, $6); }
                 ;

tipo: KW_CHAR { $$ = astCreate(AST_SYMBOL, insertSymbolTable((char*)"char", SYMBOL_CHAR), NULL, NULL, NULL, NULL); }
    | KW_INT { $$ = astCreate(AST_SYMBOL, insertSymbolTable((char*)"int", SYMBOL_INT), NULL, NULL, NULL, NULL); }
    | KW_FLOAT { $$ = astCreate(AST_SYMBOL, insertSymbolTable((char*)"float", SYMBOL_FLOAT), NULL, NULL, NULL, NULL); }
    | KW_BOOL { $$ = astCreate(AST_SYMBOL, insertSymbolTable((char*)"bool", SYMBOL_BOOL), NULL, NULL, NULL, NULL); }
    ;

lista_literais: literal lista_literais { $$ = astCreate(AST_LIT_LIST, NULL, $1, $2, NULL, NULL); }
              | literal { $$ = $1; }
              ;

literal: LIT_INT { $$ = astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL); }
       | LIT_CHAR { $$ = astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL); }
       | LIT_FLOAT { $$ = astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL); }
       | LIT_TRUE { $$ = astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL); }
       | LIT_FLASE { $$ = astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL); }
       ;

parametros: parametro ',' parametros { $$ = astCreate(AST_PARAM_LIST, NULL, $1, $3, NULL, NULL); }
          | parametro { $$ = $1; }
          ;

parametro: tipo TK_IDENTIFIER { $$ = astCreate(AST_PARAM, NULL, $1, astCreate(AST_SYMBOL, $2, NULL, NULL, NULL, NULL), NULL, NULL); }
         ;

declaracoes_locais: declaracao_variavel declaracoes_locais { $$ = astCreate(AST_DECL_LIST, NULL, $1, $2, NULL, NULL); }
                  | /* vazio */ { $$ = NULL; }
                  ;

bloco: '{' lista_comandos '}' { $$ = astCreate(AST_BLOCK, NULL, $2, NULL, NULL, NULL); }
     | '{' '}' { $$ = astCreate(AST_BLOCK, NULL, NULL, NULL, NULL, NULL); }
     ;

lista_comandos: comando lista_comandos { $$ = astCreate(AST_CMD_LIST, NULL, $1, $2, NULL, NULL); }
              | comando { $$ = $1; }
              ;

comando: comando_atribuicao { $$ = $1; }
       | comando_controle { $$ = $1; }
       | comando_read { $$ = $1; }
       | comando_print { $$ = $1; }
       | comando_return { $$ = $1; }
       | bloco { $$ = $1; }
       | ';' { $$ = NULL; }
       ;

comando_atribuicao: TK_IDENTIFIER '=' expressao ';'
                   { $$ = astCreate(AST_ASSIGN, NULL, astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL), $3, NULL, NULL); }
                  | TK_IDENTIFIER '[' expressao ']' '=' expressao ';'
                   { $$ = astCreate(AST_ASSIGN_VEC, NULL, astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL), $3, $6, NULL); }
                  ;

comando_controle: KW_IF '(' expressao ')' comando
                 { $$ = astCreate(AST_IF, NULL, $3, $5, NULL, NULL); }
                | KW_IF '(' expressao ')' comando KW_ELSE comando
                 { $$ = astCreate(AST_IF_ELSE, NULL, $3, $5, $7, NULL); }
                | KW_WHILE '(' expressao ')' comando
                 { $$ = astCreate(AST_WHILE, NULL, $3, $5, NULL, NULL); }
                | KW_DO comando KW_WHILE '(' expressao ')' ';'
                 { $$ = astCreate(AST_DO_WHILE, NULL, $2, $5, NULL, NULL); }
                ;

comando_read: KW_READ TK_IDENTIFIER ';'
             { $$ = astCreate(AST_READ, NULL, astCreate(AST_SYMBOL, $2, NULL, NULL, NULL, NULL), NULL, NULL, NULL); }
            ;

comando_print: KW_PRINT lista_print ';'
              { $$ = astCreate(AST_PRINT, NULL, $2, NULL, NULL, NULL); }
             ;

lista_print: elemento_print lista_print { $$ = astCreate(AST_PRINT_LIST, NULL, $1, $2, NULL, NULL); }
           | elemento_print { $$ = $1; }
           ;

elemento_print: LIT_STRING { $$ = astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL); }
              | expressao { $$ = $1; }
              ;

comando_return: KW_RETURN expressao ';'
               { $$ = astCreate(AST_RETURN, NULL, $2, NULL, NULL, NULL); }
              ;

expressao: expressao '+' expressao { $$ = astCreate(AST_ADD, NULL, $1, $3, NULL, NULL); }
         | expressao '-' expressao { $$ = astCreate(AST_SUB, NULL, $1, $3, NULL, NULL); }
         | expressao '*' expressao { $$ = astCreate(AST_MUL, NULL, $1, $3, NULL, NULL); }
         | expressao '/' expressao { $$ = astCreate(AST_DIV, NULL, $1, $3, NULL, NULL); }
         | expressao '%' expressao { $$ = astCreate(AST_MOD, NULL, $1, $3, NULL, NULL); }
         | expressao '<' expressao { $$ = astCreate(AST_LT, NULL, $1, $3, NULL, NULL); }
         | expressao '>' expressao { $$ = astCreate(AST_GT, NULL, $1, $3, NULL, NULL); }
         | expressao OPERATOR_LE expressao { $$ = astCreate(AST_LE, NULL, $1, $3, NULL, NULL); }
         | expressao OPERATOR_GE expressao { $$ = astCreate(AST_GE, NULL, $1, $3, NULL, NULL); }
         | expressao OPERATOR_EQ expressao { $$ = astCreate(AST_EQ, NULL, $1, $3, NULL, NULL); }
         | expressao OPERATOR_DIF expressao { $$ = astCreate(AST_DIF, NULL, $1, $3, NULL, NULL); }
         | expressao '&' expressao { $$ = astCreate(AST_AND, NULL, $1, $3, NULL, NULL); }
         | expressao '|' expressao { $$ = astCreate(AST_OR, NULL, $1, $3, NULL, NULL); }
         | '~' expressao { $$ = astCreate(AST_NOT, NULL, $2, NULL, NULL, NULL); }
         | '-' expressao %prec UMINUS { $$ = astCreate(AST_NEG, NULL, $2, NULL, NULL, NULL); }
         | '(' expressao ')' { $$ = $2; }
         | TK_IDENTIFIER { $$ = astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL); }
         | TK_IDENTIFIER '[' expressao ']' { $$ = astCreate(AST_VEC_ACCESS, NULL, astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL), $3, NULL, NULL); }
         | chamada_funcao { $$ = $1; }
         | literal { $$ = $1; }
         ;

chamada_funcao: TK_IDENTIFIER '(' argumentos ')'
               { $$ = astCreate(AST_FUNC_CALL, NULL, astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL), $3, NULL, NULL); }
              | TK_IDENTIFIER '(' ')'
               { $$ = astCreate(AST_FUNC_CALL, NULL, astCreate(AST_SYMBOL, $1, NULL, NULL, NULL, NULL), NULL, NULL, NULL); }
              ;

argumentos: expressao ',' argumentos { $$ = astCreate(AST_ARG_LIST, NULL, $1, $3, NULL, NULL); }
          | expressao { $$ = $1; }
          ;

%%

void yyerror(char const *mensagem) { 
    fprintf(stderr, "Erro de sintaxe na linha %d\n", yylineno);
    exit(3);
}

int main(int argc, char** argv) {
    if (argc != 3) {
        fprintf(stderr, "Uso: %s <arquivo_entrada> <arquivo_saida>\n", argv[0]);
        exit(1);
    }
    
    FILE* arquivo = fopen(argv[1], "r");
    if (!arquivo) {
        fprintf(stderr, "Erro ao abrir o arquivo %s\n", argv[1]);
        exit(2);
    }
    
    yyin = arquivo;
    SymbolTableInit();
    
    int resultado = yyparse();
    fclose(arquivo);
    
    if (resultado == 0) {
        printf("Análise sintática concluída com sucesso!\n");
        
        FILE* output = fopen(argv[2], "w");
        if (!output) {
            fprintf(stderr, "Erro ao criar arquivo de saída %s\n", argv[2]);
            exit(2);
        }
        
        astDecompile(root, output);
        fclose(output);
        
        exit(0);
    } else {
        exit(3);
    }
}